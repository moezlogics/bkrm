# ─────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. Never commit .env.local.
# The same code runs the cars, bikes and bakra mandi sites — NEXT_PUBLIC_VERTICAL
# picks which one this is. Each site gets its own database, CDN and domain.
# ─────────────────────────────────────────────────────────────────────

# ── Which marketplace ──
NEXT_PUBLIC_VERTICAL=bakra                # cars | bikes | bakra
NEXT_PUBLIC_APP_NAME="Bakra Mandi"        # fallback name (the admin sets the real one)
APP_ID=bakramandi                         # PM2 process names: bakramandi-web, bakramandi-push

# ── Domain (root domain — no sub-path) ──
NEXT_PUBLIC_APP_URL=https://example.com
NEXTAUTH_URL=https://example.com/api/auth
NEXT_PUBLIC_BASE_PATH=                    # leave empty; only for hosting under example.com/<path>
PORT=3400                                 # web app port (cars 3100, bikes 3200)
PUSH_PORT=3450                            # background push worker

# ── Secrets (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ──
NEXTAUTH_SECRET=
AUTH_SECRET=                              # same value as NEXTAUTH_SECRET
SETUP_KEY=                                # needed once, for the first-run /setup page

# ── Database (one per site) ──
MONGODB_URI=mongodb://127.0.0.1:27017/bakramandi

# ── Media: the site's own CDN (./cdn) ──
MEDIA_DRIVER=cdn                          # empty = store uploads on this server (development)
CDN_URL=https://cdn.example.com
NEXT_PUBLIC_CDN_URL=https://cdn.example.com
CDN_PUBLIC_URL=https://cdn.example.com
CDN_API_KEY=                              # one of the CDN's CDN_API_KEYS
CDN_SIGNING_SECRET=                       # same as the CDN's CDN_SIGNING_SECRET
IMAGE_HOSTS=                              # other image hosts to allow, comma-separated (optional)

# ── Email (OTP codes, verification, alerts) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Car Market <noreply@example.com>"

# ── Google sign-in (optional) ── redirect URI: https://example.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Live chat (Pusher, optional) ──
NEXT_PUBLIC_PUSHER_APP_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap2
PUSHER_APP_ID=
PUSHER_APP_SECRET=
PUSHER_CLUSTER=ap2

# ── Web push (generate: npx web-push generate-vapid-keys) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Optional ──
OPENAI_API_KEY=                           # AI spam screening
DISCORD_WEBHOOK_URL=                      # admin alerts

SETUP_KEY=